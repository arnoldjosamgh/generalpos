# ============================================================
# Jomish Business Suite - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to GitHub (it is in .gitignore).
# On Render.com, set these in the Environment tab instead.
#
# NOTE: config/config.json is intentionally excluded from git.
#       It is only used for local development fallback.
#       In production, ALL values must come from env vars below.
# ============================================================

# --- Server ---
PORT=3005
NODE_ENV=production

# --- JWT (Authentication) ---
# REQUIRED in production - server will refuse to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- Database ---
# Option A: Neon PostgreSQL (Recommended for Render hosting)
# Get this from: https://console.neon.tech -> Your Project -> Connection String
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option B: Leave DATABASE_URL blank to use local SQLite (default for development)
# DATABASE_URL=

# --- Cloudinary (Product Photo Storage) ---
# Get from: https://cloudinary.com -> Dashboard -> API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or set individually:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Web Push (VAPID) ---
# Generate a keypair: npx web-push generate-vapid-keys
# REQUIRED in production for push notifications to be secure.
VAPID_PRIVATE_KEY=your_vapid_private_key

# --- WhatsApp Integration (optional) ---
# Set to "true" to enable WhatsApp messaging (requires Puppeteer/Chromium - heavy).
# Leave unset or "false" on cloud hosting to save ~350 MB RAM.
ENABLE_WHATSAPP=false
